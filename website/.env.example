# Canonical production origin. Never use a preview deployment address.
VITE_SITE_URL=https://estera-virid.vercel.app
# Optional public owner-verification tokens; omitted from HTML when empty.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# Optional GA4 web-stream ID. No Google script loads before visitor opt-in.
VITE_GA4_ID=
# Set true for staging outside Vercel. Vercel preview builds do this automatically.
SEO_NOINDEX=false
